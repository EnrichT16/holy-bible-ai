{
  "expo": {
    "name": "Holy Bible · AI Assisted",
    "slug": "holy-bible-ai-assisted",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "holybible",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1830"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.holybible.aiassisted",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone carries your voice in prayer calls with your Prayer Circle. It is used only during a call you join, and nothing is recorded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.holybible.aiassisted",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1830"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "baseUrl": "/holy-bible-ai"
    },
    "plugins": ["expo-router", "expo-font"],
    "extra": {
      "backendUrl":"https://lionfish-app-rjo2f.ondigitalocean.app",
      "appUrl": "https://enricht16.github.io/holy-bible-ai",
      "donationUrl": "https://example.org/give",
      "giftAidUrl": "",
